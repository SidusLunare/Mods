export ModelFile_ATteam_TOW_US is 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A.fbx'
export Modele_ATteam_ITOW_US is TResourceMesh( Mesh=ModelFile_ATteam_TOW_US )
export ModelFile_ATteam_TOW_US_MID is 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A_MID/BGM71E_TOW_2A_MID.fbx'
export Modele_ATteam_ITOW_US_MID is TResourceMesh( Mesh=ModelFile_ATteam_TOW_US_MID )
export ModelFile_ATteam_TOW_US_LOW is 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A_LOW/BGM71E_TOW_2A_LOW.fbx'
export Modele_ATteam_ITOW_US_LOW is TResourceMesh( Mesh=ModelFile_ATteam_TOW_US_LOW )
// TOW porté (groupe « ATGM TOW animé ») : le châssis est animé en keyframes à la place du Carriable.
// Move/Move_Back : levée, rebond, roulis et tangage calés sur les anims de porteur (Gunner_ATGM_*_Porteur*, mêmes 20 frames).
// EngineCooldownTime = 0 : Folding/Deploying ne durent qu'un tick ; Fold = pose portée, Idle/Deploy = pose posée.
export DepictionOperator_Deployable_ATteam_ITOW_US is DepictionOperator_AnimationDeployable
(
    DeployAnimation = TResourceMatrixArrayAnimation( FileName = 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A_Idle.fbx' PlayInLoop = false )
    FoldAnimation = TResourceMatrixArrayAnimation( FileName = 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A_Fold.fbx' PlayInLoop = false )
    IdleAnimation = TResourceMatrixArrayAnimation( FileName = 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A_Idle.fbx' PlayInLoop = true )
    MoveFrontAnimation = TResourceMatrixArrayAnimation( FileName = 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A_Move.fbx' PlayInLoop = true )
    MoveBackAnimation = TResourceMatrixArrayAnimation( FileName = 'GameData:/Assets/3D/Units/US/Antichar/BGM71E_TOW_2A/BGM71E_TOW_2A_Move_Back.fbx' PlayInLoop = true )
    DeployFromMoveTime = 0.1
    DeployFromTurnTime = 0.1
    FoldForMoveTime = 0.1
    FoldForTurnTime = 0.1
    FilterTurretBoneForAllAnimation = true
)
