//-----------------------------------------------------------------------------------
//***********************************************************************************
//-----------------------------------------------------------------------------------
template SceneryDescriptor_TransitionSingleFX
[
    ActionDescriptor,
] is TSceneryDescriptorFX
(
    ActionDescriptors = [ <ActionDescriptor> ]
    PlayOnlyOnce = true
    Mode = SDMode_FXModel
)
//-----------------------------------------------------------------------------------
template SceneryDescriptor_TransitionFX
[
    ActionDescriptors,
] is TSceneryDescriptorFX
(
    ActionDescriptors = <ActionDescriptors>
    PlayOnlyOnce = true
    Mode = SDMode_FXModel
)
//-----------------------------------------------------------------------------------
//***********************************************************************************
//-----------------------------------------------------------------------------------
template SceneryDescriptor_Light_Static
[
    RegistrationName    : string            = '',
    Tags                : LIST<string>      = [],
    Color               : float3,
    Falloff             : float,
    RadiusInMeters      : float             = 20,
] is TSceneryDescriptorFX
(
    SymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy
    RegistrationName = <RegistrationName>
    Tags = <Tags>
    Mode = SDMode_StaticFX
    ActionDescriptors =
    [
        // (Vivien 13/10/2021) Le FX doit être déclaré export car on le retrouve InGame via le TNDFDatabase.
        export Fx is TActionCall
        (
            Action = $/VFX_Bank/FX_Binder_Light_Static
            NamedParams = MAP[
                ('parRadiusLBU' , <RadiusInMeters>),
                ('parColor'  , <Color>),
                ('parFallOff', <Falloff>),
            ]
        )
    ]
)
//-----------------------------------------------------------------------------------
//***********************************************************************************
//-----------------------------------------------------------------------------------
template SceneryDescriptor_FX
[
    RegistrationName    : string,
    Tags                : LIST<string>      = [],
    Action,
] is TSceneryDescriptorFX
(
    SymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy
    RegistrationName = <RegistrationName>
    Tags = <Tags>
    Mode = SDMode_StaticFX
    ActionDescriptors =
    [
        export Fx is TActionCall (Action = <Action> )
    ]
)
//-----------------------------------------------------------------------------------
//***********************************************************************************
//-----------------------------------------------------------------------------------
template Template_FXWithRandomDuration
[
    Action : TActionDescriptor,
    DurationMinInSec : float,
    DurationMaxInSec : float,
]is TCompetitionAction
(
    Actions =
    [
        TActionCall
        (
            Action = <Action>
        ),
        TWaitInSec(Duration = $/VFX_Bank/RandomRange[<DurationMinInSec>, <DurationMaxInSec>])
    ]
)

template SceneryDescriptor_FXWithRandomDuration
[
    RegistrationName    : string,
    Tags                : LIST<string> = [],
    Action,
    DurationMinInSec    : float,
    DurationMaxInSec    : float,
] is TSceneryDescriptorFX
(
    SymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy
    RegistrationName = <RegistrationName>
    Tags = <Tags>
    Mode = SDMode_StaticFX
    ActionDescriptors =
    [
        export Fx is Template_FXWithRandomDuration
        (
            Action = <Action>
            DurationMinInSec = <DurationMinInSec>
            DurationMaxInSec = <DurationMaxInSec>
        )
    ]
)
