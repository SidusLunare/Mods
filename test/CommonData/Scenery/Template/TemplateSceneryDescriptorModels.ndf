template SceneryDescriptor_Model_Steelman
[
    RegistrationName           : string,
    Tags                       : LIST<string>     = [],
    Model                      : TResourceMesh,

    SymbolDatabaseProxy        : TLevelBuildSymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy,
] is TSceneryDescriptorMultiState
(
    RegistrationName = <RegistrationName>
    Tags = <Tags>
    SymbolDatabaseProxy = <SymbolDatabaseProxy>

    StateMaskHidden = SDMask_Hidden

    Fallback = TSceneryDescriptorModel3D
    (
        Resource = <Model>
        ModeMask = SDMode_High + SDMode_Mid + SDMode_Low
        MaterialTextureDico = $/M3D/Misc/MaterialTextureDico
        SceneryMeshBucketHandlerDico = $/SceneryBase/SceneryMeshBucketHandlerDicoOpaque_Low
        ContentTypeIfIndividualMesh = ContentType_IndividualMesh_LevelBuild_Low
        HasNoBetterResolution = true
    )
)
