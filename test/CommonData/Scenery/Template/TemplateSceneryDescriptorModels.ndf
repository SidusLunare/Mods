//***********************************************************************************
//-----------------------------------------------------------------------------------
template SceneryDescriptor_Model
[
    ModelHigh                  : TResourceMesh    = nil,
    ModelHigh_dest             : TResourceMesh    = nil,
    ModelMid                   : TResourceMesh    = nil,
    ModelMid_dest              : TResourceMesh    = nil,
    ModelLow                   : TResourceMesh    = nil,
    ModelLow_dest              : TResourceMesh    = nil,
    ModelProxy                 : TResourceMesh    = nil,
    RegistrationName           : string           = '',
    Tags                       : LIST<string>     = [],
    Destroyable                : bool             = true,
    HideMode                   : int          = HideMode/Classic,
    BuildingType               : int          = BuildingType/None,
    BlockVisionWhenDestructed  : bool             = false,
    IsForDistrict              : bool             = false,
    InfiniteLodRange           : bool             = false,
    TangentFloor               : bool             = false,
    TangentFloorForLine        : bool             = false,
    FxDestruction              : TBaseClass       = nil,
    SymbolDatabaseProxy        : TLevelBuildSymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy,
    LodConfig                  : TLodConfig        = nil,
] is SceneryDescriptor_Destroyable
(
    RegistrationName = <RegistrationName>
    Tags = <Tags>

    LodConfig is (<LodConfig> != nil ? <LodConfig> : (<BuildingType> == BuildingType/Big ? $/SceneryDB/LodConfig_Building : $/SceneryDB/LodConfig_Medium))

    Destroyed = (<ModelHigh_dest> != nil) ? SceneryDescriptor_MultiMode_Model
    (
        ModelHigh = <ModelHigh_dest>
        ModelMid = <ModelMid_dest>
        ModelLow = <ModelLow_dest>
        ModelProxy = <ModelProxy>
        LodConfig = LodConfig
        InfiniteLodRange = <InfiniteLodRange>
        TangentFloor = <TangentFloor>
        TangentFloorForLine = <TangentFloorForLine>
    ) : nil
    FxDestruction = <FxDestruction>
    Destroyable = <Destroyable>

    StateMaskHidden = <HideMode> == HideMode/Vegetation ? (SDMask_Hidden + SDMask_HideVeget) : (<HideMode> == HideMode/Classic ? SDMask_Hidden : 0)

    Fallback = SceneryDescriptor_MultiMode_Model
    (
        ModelHigh = <ModelHigh>
        ModelMid = <ModelMid>
        ModelLow = <ModelLow>
        ModelProxy = <ModelProxy>
        BuildingType = <BuildingType>
        BlockVisionWhenDestructed = <BlockVisionWhenDestructed>
        IsForDistrict = <IsForDistrict>
        LodConfig = LodConfig
        InfiniteLodRange = <InfiniteLodRange>
        TangentFloor = <TangentFloor>
        TangentFloorForLine = <TangentFloorForLine>
    )

    SymbolDatabaseProxy = <SymbolDatabaseProxy>
)
//-----------------------------------------------------------------------------------
template SceneryDescriptor_Colossus
[
    ModelHigh                  : TResourceMesh    = nil,
    ModelHigh_dest             : TResourceMesh    = nil,
    ModelMid                   : TResourceMesh    = nil,
    ModelMid_dest              : TResourceMesh    = nil,
    ModelLow                   : TResourceMesh    = nil,
    ModelLow_dest              : TResourceMesh    = nil,
    ModelProxy                 : TResourceMesh    = nil,
    RegistrationName           : string           = '',
    Tags                       : LIST<string>     = [],
    Destroyable                : bool             = false,
    BuildingType               : int          = BuildingType/None,
    IsForDistrict              : bool             = false,
    TangentFloor               : bool             = false,
    TangentFloorForLine        : bool             = false,
    FxDestruction              : TBaseClass       = nil,
    SymbolDatabaseProxy        : TLevelBuildSymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy,
] is SceneryDescriptor_Model
(
    ModelHigh                  = <ModelHigh>
    ModelHigh_dest             = <ModelHigh_dest>
    ModelMid                   = <ModelMid>
    ModelMid_dest              = <ModelMid_dest>
    ModelLow                   = <ModelLow>
    ModelLow_dest              = <ModelLow_dest>
    ModelProxy                 = <ModelProxy>
    RegistrationName           = <RegistrationName>
    Tags                       = <Tags>
    Destroyable                = <Destroyable>
    HideMode                   = HideMode/Never
    BuildingType               = <BuildingType>
    IsForDistrict              = <IsForDistrict>
    InfiniteLodRange           = true
    TangentFloor               = <TangentFloor>
    TangentFloorForLine        = <TangentFloorForLine>
    FxDestruction              = <FxDestruction>
    SymbolDatabaseProxy        = <SymbolDatabaseProxy>
    LodConfig                  = $/SceneryDB/LodConfig_Colossus
)
