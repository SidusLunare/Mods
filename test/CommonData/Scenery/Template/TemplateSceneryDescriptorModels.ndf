HideMode is TBaseClass
(
    Never      is 0
    Classic    is 1
    Vegetation is 2
)
//-----------------------------------------------------------------------------
BuildingType is TBaseClass
(
    None  is 0
    Small is 1
    Big   is 2
    Ruin  is 3
)
