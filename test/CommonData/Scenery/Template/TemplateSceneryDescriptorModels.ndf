template SceneryDescriptor_MultiMode_Model_AnimatedDestruction [

    BuildingType               : int          = BuildingType/None,
    BlockVisionWhenDestructed  : bool             = false,
    IsForDistrict              : bool             = false,
    LodConfig                  : TLodConfig,
    InfiniteLodRange           : bool             = false,
    TangentFloor               : bool             = false,
    TangentFloorForLine        : bool             = false,

    FxDestruction              : TBaseClass       = nil,

    ModelHigh_AnimDest         : TResourceMesh    = nil,
    ModelMid_AnimDest          : TResourceMesh    = nil,
    ModelLow_AnimDest          : TResourceMesh    = nil,

    ModelHigh_StaticDest       : TResourceMesh    = nil,
    ModelMid_StaticDest        : TResourceMesh    = nil,
    ModelLow_StaticDest        : TResourceMesh    = nil,

    AnimationForceDuration     : float            = 0,
] is SceneryDescriptor_MultiMode_Model
(
    HasModelHigh_AnimDest   is (<ModelHigh_AnimDest>   != nil)
    HasModelMid_AnimDest    is (<ModelMid_AnimDest>    != nil)
    HasModelLow_AnimDest    is (<ModelLow_AnimDest>    != nil)

    HasModelHigh_StaticDest is (<ModelHigh_StaticDest> != nil)
    HasModelMid_StaticDest  is (<ModelMid_StaticDest>  != nil)
    HasModelLow_StaticDest  is (<ModelLow_StaticDest>  != nil)

    FxDestruction = <FxDestruction>

    BuildingType = <BuildingType>
    BlockVisionWhenDestructed = <BlockVisionWhenDestructed>
    IsForDistrict = <IsForDistrict>
    LodConfig = <LodConfig>
    InfiniteLodRange = <InfiniteLodRange>
    TangentFloor = <TangentFloor>
    TangentFloorForLine = <TangentFloorForLine>

    ModelHigh = HasModelHigh_AnimDest ? <ModelHigh_AnimDest> : <ModelHigh_StaticDest>
    AnimationHigh = HasModelHigh_AnimDest ? TSceneryMeshAnimation
    (
        AnimationRandomOffset = false
        ResourceAnimation = TResourceMatrixArrayAnimation
        (
            FileName = <ModelHigh_AnimDest>.Mesh
            PlayInLoop = false
            ForceDuration = <AnimationForceDuration>
        )
        WhenFinished = HasModelHigh_StaticDest ? SceneryDescriptor_ModelImpl_High
        (
            ModelHigh = <ModelHigh_StaticDest>
            ModeMask = SDMode_High_Baked
            TangentFloor = <TangentFloor>
            TangentFloorForLine = <TangentFloorForLine>
            Animation = nil
            ProcessBoxAboveGround = false
            NavigationAspect = nil
        ) : nil
    ) : nil

    ModelMid = HasModelMid_AnimDest ? <ModelMid_AnimDest> : <ModelMid_StaticDest>
    AnimationMid = HasModelMid_AnimDest ? TSceneryMeshAnimation
    (
        AnimationRandomOffset = false
        ResourceAnimation = TResourceMatrixArrayAnimation
        (
            FileName = <ModelMid_AnimDest>.Mesh
            PlayInLoop = false
            ForceDuration = <AnimationForceDuration>
        )
        WhenFinished = HasModelMid_StaticDest ? SceneryDescriptor_ModelImpl_Mid
        (
            ModelMid = <ModelMid_StaticDest>
            TangentFloor = <TangentFloor>
            TangentFloorForLine = <TangentFloorForLine>
            Animation = nil
        ) : nil
    ) : nil

    ModelLow = HasModelLow_AnimDest ? <ModelLow_AnimDest> : <ModelLow_StaticDest>
    AnimationLow = HasModelLow_AnimDest ? TSceneryMeshAnimation
    (
        AnimationRandomOffset = false
        ResourceAnimation = TResourceMatrixArrayAnimation
        (
            FileName = <ModelLow_AnimDest>.Mesh
            PlayInLoop = false
            ForceDuration = <AnimationForceDuration>
        )
        WhenFinished = HasModelLow_StaticDest ? SceneryDescriptor_ModelImpl_Low
        (
            ModelLow = <ModelLow_StaticDest>
            ModeMask = SDMode_Low
            TangentFloor = <TangentFloor>
            TangentFloorForLine = <TangentFloorForLine>
            Animation = nil
        ) : nil
    ) : nil
)
//------------------------------------------------------------------------------
template SceneryDescriptor_Model_AnimatedDestruction [
    RegistrationName           : string           = '',
    Tags                       : LIST<string>     = [],

    BuildingType               : int          = BuildingType/None,
    BlockVisionWhenDestructed  : bool             = false,
    IsForDistrict              : bool             = false,
    InfiniteLodRange           : bool             = false,
    TangentFloor               : bool             = false,
    TangentFloorForLine        : bool             = false,

    FxDestruction              : TBaseClass       = nil,

    ModelHigh                  : TResourceMesh    = nil,
    ModelMid                   : TResourceMesh    = nil,
    ModelLow                   : TResourceMesh    = nil,

    ModelHigh_AnimDest         : TResourceMesh    = nil,
    ModelMid_AnimDest          : TResourceMesh    = nil,
    ModelLow_AnimDest          : TResourceMesh    = nil,

    ModelHigh_StaticDest       : TResourceMesh    = nil,
    ModelMid_StaticDest        : TResourceMesh    = nil,
    ModelLow_StaticDest        : TResourceMesh    = nil,

    AnimationForceDuration     : float            = 0,

    LodConfig                  : TLodConfig    = nil,
] is SceneryDescriptor_Destroyable
(
    RegistrationName = <RegistrationName>
    Tags = <Tags>

    StateMaskHidden = SDMask_Hidden

    LodConfig is (<LodConfig> != nil ? <LodConfig> : (<BuildingType> == BuildingType/Big ? $/SceneryDB/LodConfig_Building : $/SceneryDB/LodConfig_Medium))

    Fallback = SceneryDescriptor_MultiMode_Model
    (
        ModelHigh = <ModelHigh>
        ModelMid = <ModelMid>
        ModelLow = <ModelLow>
        BuildingType = <BuildingType>
        BlockVisionWhenDestructed = <BlockVisionWhenDestructed>
        IsForDistrict = <IsForDistrict>
        LodConfig = LodConfig
        InfiniteLodRange = <InfiniteLodRange>
        TangentFloor = <TangentFloor>
        TangentFloorForLine = <TangentFloorForLine>
    )

    Destroyable = true
    Destroyed = SceneryDescriptor_MultiMode_Model_AnimatedDestruction
    (
        TangentFloor = <TangentFloor>
        TangentFloorForLine = <TangentFloorForLine>

        ModelHigh_AnimDest = <ModelHigh_AnimDest>
        ModelMid_AnimDest = <ModelMid_AnimDest>
        ModelLow_AnimDest = <ModelLow_AnimDest>

        ModelHigh_StaticDest = <ModelHigh_StaticDest>
        ModelMid_StaticDest = <ModelMid_StaticDest>
        ModelLow_StaticDest = <ModelLow_StaticDest>

        LodConfig = LodConfig

        AnimationForceDuration = <AnimationForceDuration>
    )
    FxDestruction = <FxDestruction>
)
//------------------------------------------------------------------------------
template SceneryDescriptor_Model_ArmoryAnimationLoop [
    RegistrationName : string = '',
    Tags : LIST<string> = [],
    Model : TResourceMesh = nil,
] is TSceneryDescriptorMultiState
(
    RegistrationName = <RegistrationName>
    Tags = <Tags>
    SymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy
    StateMaskHidden = SDMask_Hidden

    Animation is TSceneryMeshAnimation
    (
        AnimationRandomOffset = true
        ResourceAnimation = TResourceMatrixArrayAnimation
        (
            FileName = <Model>.Mesh
            PlayInLoop = true
            ForceDuration = 0
        )
    )

    Fallback = TSceneryDescriptorModel3D
    (
        Resource = <Model>
        ModeMask = SDMode_High + SDMode_Mid + SDMode_Low
        SceneryMeshBucketHandlerDico = $/SceneryBase/SceneryMeshBucketHandlerDicoOpaque_Low
        ContentTypeIfIndividualMesh = ContentType_IndividualMesh_LevelBuild_Low
        MaterialTextureDico = $/M3D/Misc/MaterialTextureDico
        HasNoBetterResolution = true
        Animation = Animation
    )
)
