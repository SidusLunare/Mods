template SceneryDescriptor_MultiMode_Model
[
    ModelHigh                  : TResourceMesh = nil,
    ModelMid                   : TResourceMesh = nil,
    ModelLow                   : TResourceMesh = nil,
    ModelProxy                 : TResourceMesh = nil,
    BuildingType               : int    = BuildingType/None,
    BlockVisionWhenDestructed  : bool       = false,
    IsForDistrict              : bool       = false,
    LodConfig                  : TLodConfig,
    InfiniteLodRange           : bool       = false,
    TangentFloor               : bool       = false,
    TangentFloorForLine        : bool       = false,
    FxDestruction              : TBaseClass = nil,
    AnimationHigh              : TBaseClass = nil,
    AnimationMid               : TBaseClass = nil,
    AnimationLow               : TBaseClass = nil,
] is TSceneryDescriptorMultiMode
(
    SymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy

    RaytraceModeMask is <BuildingType> == BuildingType/None ? 0 : (<BlockVisionWhenDestructed> ? SDMode_RaytraceBuilding | SDMode_RaytraceHighBuilding : SDMode_RaytraceBuilding)
    NavigationModeMask is <IsForDistrict> ? SDMode_District : SDMode_Navigation
    ModeHigh is SDMode_High_Baked | RaytraceModeMask | (<BuildingType> == BuildingType/None ? 0 : NavigationModeMask) | (<IsForDistrict> ? SDMode_District : 0)
    High is SceneryDescriptor_ModelImpl_High
    (
        ModelHigh                  = <ModelHigh>
        ModeMask                   = ModeHigh
        TangentFloor               = <TangentFloor>
        TangentFloorForLine        = <TangentFloorForLine>
        Animation                  = <AnimationHigh>
        ProcessBoxAboveGround      = <BuildingType> != BuildingType/None | <IsForDistrict>
        NavigationAspect           = (<BuildingType> != BuildingType/None) ? TSceneryDescriptorNavigationAspect
        (
            TerrainType = (<BuildingType> == BuildingType/Small) ? ETerrainType/PetitBatiment :
                          ((<BuildingType> == BuildingType/Ruin) ? ETerrainType/Ruin :
                          ETerrainType/Batiment)
        ) : nil
    )

    Mid is SceneryDescriptor_ModelImpl_Mid
    (
        ModelMid                   = <ModelMid>
        TangentFloor               = <TangentFloor>
        TangentFloorForLine        = <TangentFloorForLine>
        Animation                  = <AnimationMid>
    )


    ModeLow is SDMode_Low | (<InfiniteLodRange> ? SDMode_StaticGeometry : 0)
    Low is SceneryDescriptor_ModelImpl_Low
    (
        ModelLow                   = <ModelLow>
        ModeMask                   = ModeLow
        TangentFloor               = <TangentFloor>
        TangentFloorForLine        = <TangentFloorForLine>
        Animation                  = <AnimationLow>
    )

    RaytraceObject is SceneryDescriptor_ModelImpl_Raytrace
    (
        ModelRaytrace       = <ModelProxy>
        ModeMask            = SDMode_RaytraceObject
        TangentFloor        = <TangentFloor>
        TangentFloorForLine = <TangentFloorForLine>
    )

    ModeEntry =
    [
        TSceneryDescriptorMultiLOD
        (
            LodConfig = <LodConfig>
            High = (<ModelHigh> != nil) ? [ High ] : []
            Mid = (<ModelMid> != nil) ? [ Mid ] : []
            Low = (<ModelLow> != nil) ? [ Low ] : []
        )
    ]
    +
    ( <FxDestruction> != nil  ? [ <FxDestruction> ] : [] )
    +
    ( (<ModelProxy> != nil) ? [ RaytraceObject ] : [] )
)
//-----------------------------------------------------------------------------------
//***********************************************************************************
//-----------------------------------------------------------------------------------
template SceneryDescriptor_Destroyable
[
    RegistrationName        : string            = '',
    Tags                    : LIST<string>     = [],

    StateMaskDestroyed      : int           = SDMask_SquashOrDestroy,
    StateMaskHidden         : int           = SDMask_Hidden,

    Fallback                : TBaseClass        = nil,
    Destroyed               : TBaseClass        = nil,
    FxDestruction           : TBaseClass        = nil,
    Destroyable             : bool              = true,

    SymbolDatabaseProxy     : TLevelBuildSymbolDatabaseProxy = $/M3D/Scene/LevelBuildSymbolDatabaseProxy,

] is TSceneryDescriptorMultiState
(
    IsDestroyable               is (<Destroyable> | ( <Destroyed> != nil ))
    IsDestroyableWithModel      is (IsDestroyable & ( <Destroyed> != nil ))
    IsDestroyableWithFx         is (IsDestroyable & ( <FxDestruction> != nil ))
    HideOnDestruction           is (IsDestroyable & ( <Destroyed> == nil ) & ( <FxDestruction> == nil ))

    RegistrationName            = <RegistrationName>
    Tags                        = <Tags>
    SymbolDatabaseProxy         = <SymbolDatabaseProxy>

    StateMaskHidden = <StateMaskHidden> + (HideOnDestruction ? SDMask_SquashOrDestroy : 0)
    Alternatives = [] + (
        (IsDestroyableWithModel | IsDestroyableWithFx) ?
            [TSceneryDescriptorMultiStateEntry
            (
                StateMask = <StateMaskDestroyed>
                SceneryDescriptors =
                [
                    TSceneryDescriptorMultiMode
                    (
                        ModeEntry = []
                        + (IsDestroyableWithModel ?
                        [
                            <Destroyed>
                        ] : [])
                        + (IsDestroyableWithFx ?
                        [
                            <FxDestruction>
                        ] : [])
                    )
                ]
            )] : []
        )

    Fallback = <Fallback>
)
