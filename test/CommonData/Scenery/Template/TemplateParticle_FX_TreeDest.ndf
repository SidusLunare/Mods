            AuthorizedMeshes = <FoliageModel>
            Duration = <LeafDisplayTime>
            OverrideMeshMaterial = $/M3D/Shader/MeshMaterial_Shader_Scenery_Foliage
            SortTriangles = true
            RenderLayerSelector = TRenderLayerSelector( RenderLayerName = 'Calque_Vegetation' )
        ),
        private DustAndRubbles is TSequentialAction
        (
            Actions =
            [
                private Wait is TWaitInSec
                (
                    Duration = 1.8  //1.5
                ),
                private Dust is TActionCall
                (
                    Action = $/VFX_Bank/BANK_WasteGroundDust
                    NamedParams = MAP[
                        ('BANK_ParticleLifetime', $/VFX_Bank/RandomRange[4, 8] ),
                        ('BANK_InitRotation', $/VFX_Bank/RandomUnit ),
                        ('BANK_ParticuleStartSize', 800),
                        ('BANK_ParticuleEndSize', 1600),
                        ('BANK_ParticleCount', 8),
                        ('BANK_ParticleRotationFactor', $/VFX_Bank/RandomRange[0.5, 1.5]),
                        ('BANK_InitRGBcolor', float3[105, 80, 85] div 255.0),
                        ('BANK_EndRGBcolor', float3[30, 20, 15] div 255.0),
                        ('BANK_OffsetPos', float3[0,0,0]),
                        ('BANK_InitPosition', float3[0, 1000, 0] + float3[200, 1000, 200] * $/VFX_Bank/MinusOneToOneRandomHemisphereVolume),
                        ('BANK_InitSpeed', $/VFX_Bank/MinusOneToOneRandomDisc * 800 ),
                        ('BANK_AlphaMul', $/VFX_Bank/RandomRange[1, 5]  ),
                        ('BANK_AlphaStartDecayValue', 0.1 ),
                        ('BANK_FluidFriction', 2 ),
                        ('BANK_AccelerationField', $/VFX_Bank/MapWind + float3[0.00, 0.00, 100.00] ),
                        ('BANK_ParticuleScaleSizeFactor', $/VFX_Bank/RandomRange[0.5, 2] )
                    ]
                ),
                private Leaves is VegetationParticleBombSpawner
                (
                    Count = <FoliageDensity>
