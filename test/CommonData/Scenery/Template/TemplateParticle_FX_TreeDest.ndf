                    Spawner = TParticleSpawner
                    (
                        ParticleLifetime = 3
                        Initialisers =
                        [
                            VegetationParticleInitialiserList
                            (
                                ColorModifier = float3[1, 1, 1]
                                Alpha = 1.0

                                Position = <FoliagePosition> + $/VFX_Bank/MinusOneToOneRandomSphereVolume * <FoliageSize>
                                Speed = $/VFX_Bank/MinusOneToOneRandomHemisphereVolume * float3[1,1,-1] * 500
                                Size = $/VFX_Bank/RandomRange[0.8, 1.2] * <LeafSize>
                                RotationSpeed = $/VFX_Bank/MinusOneToOneRandomHemisphereVolume * 0.5
                                Rotation = $/VFX_Bank/RandomUnit
                                Direction = $/VFX_Bank/MinusOneToOneRandomSphereSurface
                            ),
                        ]
                        ParticleDescriptor = TParticleDescriptor
                        (
                            RenderInfo = VegetationParticleRenderInfo
                            (
                                TextureName = <FoliageTexture>
                            )
                            Evolver = VegetationParticleStandardEvolverListWithPhysic
                            (
                                FluidFriction = 0.25
                                PhysicWindField = $/VFX_Bank/MapWind + float3[0, 0, -9000]
                                Opacity = $/VFX_Bank/AttackDecay[$/VFX_Bank/ParticleLifeRatio, 0.1]
                            )
                            ParticleRenderer = $/VFX_Bank/LitParticleRenderer
                            FxStickerTracker = $/M3D/Scene/TerrainCDLODFxStickerTracker
