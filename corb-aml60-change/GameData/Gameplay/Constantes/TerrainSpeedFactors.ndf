
export InfantryTerrainSpeedFactors is TRTTIGameplayTerrainSpeedFactors
(
    SpeedFactorPerTerrainType = MAP [
        (~/ETerrainType/ForetDense, 1),
        (~/ETerrainType/ForetLegere, 0.75),
        (~/ETerrainType/PetitBatiment, 0.5),
        (~/ETerrainType/Batiment, 0.5),
        (~/ETerrainType/Ruin, 0.5),
        (~/ETerrainType/Rocher, 1),
        (~/ETerrainType/EauPeuProfonde, 0.8),
        (~/ETerrainType/EauProfonde, 0.8),
    ]
)

export MountaineerTerrainSpeedFactors is TRTTIGameplayTerrainSpeedFactors
(
    SpeedFactorPerTerrainType = MAP [] // "mountainer" annule tous les coefficients de vitesse de terrain (on garde la valeur par défaut 1)
)

