unnamed TMapDefinition
(
    Name = ~/MapName
    Size = float2[MapCellSize * ~/NbCaseX, MapCellSize * ~/NbCaseY]

    PreviewTexture = TUIResourceTexture
    (
        FileName = "LevelBuildData:/" + ~/MapName + "/Preview.webp"
    )

    OverviewTexture = TUIAutoRegisteredResourceTexture
    (
        FileName = "LevelBuildData:/" + ~/MapName + "/Overview.webp"
    )

    ClusterLoad = TCompositeCluster
    (
        SubClusterList =
        [
            TemplateClusterLoadNDF
            (
                BaseName = "Maps/" + ~/MapName + "/MapLoader.txn"
                NameSpace = "ClusterMap/" + ~/MapName
                Public = true
                Files =
                [
                    "LevelBuildData:/" + ~/MapName + "/Map.ndf",
                    "CommonData:/Map/ClusterLoadMap.ndf",
                    "CommonData:/Map/Template/MapJuncture.ndf",
                    "CommonData:/Clusters/_TemplateClusters.ndf",
                    "CommonData:/Clusters/ReloadableType.ndf",
                ]
            ),
            TClusterStartNamedCluster(
                SubClusterName = "$/ClusterMap/" + ~/MapName + "/ClusterLoadMap"
            )
        ]
    )
)
